# auto picks vLLM if it is up, otherwise a local GPU with the Hugging Face
# extra, otherwise the Datalab API when DATALAB_API_KEY is set.
# Other values: vllm, hf, datalab, mock
CHANDRA_ENGINE=auto

# Hosted fallback. Documents are sent to Datalab. Leave empty to stay fully local.
DATALAB_API_KEY=

# Local vLLM server started by `docker compose --profile gpu up`.
VLLM_API_BASE=http://127.0.0.1:8000/v1
VLLM_MODEL_NAME=chandra
MODEL_CHECKPOINT=datalab-to/chandra-ocr-2

# Chandra's own default. Dense pages can use the whole budget.
MAX_OUTPUT_TOKENS=12384

# Optional lock. If set, the desk asks for this token in the browser.
ACCESS_TOKEN=

# Set to 1 only if you accept multi-minute pages and possible out-of-memory kills.
ALLOW_CPU=0

# Where uploads and results are stored.
DATA_DIR=./data

# Ports. The phone uses WEB_PORT. The API stays on PORT.
WEB_PORT=8787
PORT=8791

# Comma-separated LAN addresses to advertise. Leave empty to detect them.
ADVERTISED_HOSTS=

# Safety valves.
MAX_UPLOAD_BYTES=2147483648
MAX_PAGES=5000
CHUNK_SIZE=8388608

# vLLM context. Lower this (for example 8192) on a 16 GB card if the server
# runs out of memory. Used by docker compose --profile gpu.
VLLM_MAX_MODEL_LEN=18000
